# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name
MONGODB_DB=face_recognition_db

# Flask secret (generate a long random string)
SECRET_KEY=replace-with-a-long-random-secret-key

# Optional: set to 1 for local debug only
FLASK_DEBUG=0

# Similarity thresholds (cosine). Re-calibrate on your own data.
DUPLICATE_THRESHOLD=0.55
RECOGNITION_THRESHOLD=0.48
UNCERTAIN_THRESHOLD=0.40

# Rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# CORS origins (comma-separated). Use * only for quick demos.
CORS_ORIGINS=*
