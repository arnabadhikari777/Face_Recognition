# Copy to .env for local use. NEVER commit .env. Placeholders only.
#
# MongoDB Atlas connection string
# Get it from: Atlas → Database → Connect → Drivers → copy the SRV string.
# Replace <DB_USER>, <DB_PASSWORD>, and <CLUSTER_HOST>.
# If the password contains special characters, URL-encode them
# (e.g. @ → %40, # → %23, / → %2F, : → %3A, ? → %3F, % → %25).
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/?retryWrites=true&w=majority
MONGODB_DB_NAME=face_recognition_db
MONGODB_COLLECTION=identities

# Optional but recommended: encrypts templates in MongoDB.
# Generate once and keep it safe (losing it makes stored templates unreadable):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you already have encrypted records, keep the SAME key. Do not rotate casually.
TEMPLATE_ENCRYPTION_KEY=

# Models / thresholds (defaults: models/model_manifest.json, models/calibration.json)
MANIFEST_FILE=
CALIBRATION_FILE=
ENROLL_REQUIRE_ALL=false

# Retention / capacity (0 = keep forever)
RETENTION_DAYS=0
MAX_RECORDS=1500

# HTTP
TRUST_PROXY=true
ALLOWED_ORIGINS=
MAX_CONTENT_LENGTH=524288

# Rate limits
RATE_REGISTER_PER_HOUR=10
RATE_RECOGNIZE_PER_MINUTE=30
RATE_DEFAULT_PER_MINUTE=60

# Build time only (scripts/download_models.sh)
ACCEPT_NONCOMMERCIAL_MODEL_LICENSES=1
# DOWNLOAD_RETRIES=4
# MODELS_DEST=static/models
# MODEL_SEED_DIR=
