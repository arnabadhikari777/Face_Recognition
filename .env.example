# Copy to .env for local use. NEVER commit .env. Placeholders only.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=face_recognition_db
MONGODB_COLLECTION=registered_faces

# Matching (see README "Threshold calibration")
MATCH_THRESHOLD=0.363
UNCERTAIN_LOW=0.30
MATCH_MARGIN=0.05
MIN_SUPPORTING_SAMPLES=2
SELF_CONSISTENCY_MIN=0.15

# Retention / capacity
RETENTION_DAYS=90
MAX_RECORDS=5000

# HTTP
TRUST_PROXY=true
ALLOWED_ORIGINS=
MAX_CONTENT_LENGTH=65536
RATE_REGISTER_PER_HOUR=10
RATE_RECOGNIZE_PER_MINUTE=30
RATE_DEFAULT_PER_MINUTE=60
