  "detection": { "score_threshold": 0.5, "fallback_below_score": 0.6 },
  "quality": {
    "calibrated": false,
    "note": "Provisional engineering defaults. Calibrate with tools/benchmark.py on real images from your own devices.",
    "min_detection_score": 0.6,
    "min_face_frac": 0.18,
    "max_face_frac": 0.85,
    "min_eye_distance_px": 50,
    "min_brightness": 60,
    "max_brightness": 200,
    "min_contrast": 25,
    "max_clip_frac": 0.25,
    "min_sharpness": 40,
    "max_motion_blur": 1.6,
    "max_motion_frac": 0.04,
    "min_landmark_agreement": 0.85,
    "max_roll_deg": 20,
    "front_max_yaw": 0.15,
    "front_max_pitch": 0.08,
    "any_max_yaw": 0.5,
    "side_min_yaw": 0.2,
    "side_max_yaw": 0.7,
    "vertical_min_pitch": 0.08,
    "min_frame_quality": 0.35
  },
  "registration": {
    "plan": [
      { "pose": "front", "count": 3, "optional": false, "text": "Look straight at the camera." },
      { "pose": "left", "count": 2, "optional": false, "text": "Slowly turn your face slightly to your left." },
      { "pose": "right", "count": 2, "optional": false, "text": "Now turn your face slightly to your right." },
      { "pose": "up", "count": 1, "optional": true, "text": "Tilt your chin slightly up." },
      { "pose": "down", "count": 1, "optional": true, "text": "Tilt your chin slightly down." }
    ],
    "min_templates": 6,
    "max_templates": 10,
    "burst_frames": 5,
    "burst_timeout_ms": 7000,
    "duplicate_similarity": 0.97,
    "outlier_mad_k": 3.0
  },
  "recognition": { "burst_frames": 5, "min_frames": 3, "burst_timeout_ms": 7000 }
}
